<?xml version="1.0" encoding="utf-8"?>
<!--
    Variante compacta para el espacio reducido del widget. Conserva el mismo
    símbolo, pero compensa el margen interno del vector original sin cambiar
    su tamaño en la cabecera y en otras superficies de Nolvida.
-->
