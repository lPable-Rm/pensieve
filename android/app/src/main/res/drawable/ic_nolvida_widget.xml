    android:height="36dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <group
        android:pivotX="512"
        android:pivotY="480"
        android:scaleX="1.45"
        android:scaleY="1.45">

        <path
            android:fillColor="@android:color/black"
            android:fillType="evenOdd"
            android:pathData="M 286,329 H 688 V 438 L 744,585 L 671,607 V 723 H 542 V 805 H 286 Z M 542,438 V 502 H 603 V 438 Z" />

        <group
            android:pivotX="380"
            android:pivotY="212.5"
            android:rotation="-23">
            <path
                android:fillColor="@android:color/black"
                android:pathData="M 357,160 H 403 V 265 H 357 Z" />
        </group>

        <path
            android:fillColor="@android:color/black"
            android:pathData="M 473,159 H 520 V 236 H 473 Z" />

        <group
            android:pivotX="617"
            android:pivotY="212.5"
            android:rotation="23">
            <path
                android:fillColor="@android:color/black"
                android:pathData="M 594,160 H 640 V 265 H 594 Z" />
        </group>
    </group>
</vector>
