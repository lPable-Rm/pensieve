<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+: permite mostrar recordatorios tras el consentimiento del usuario. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Solo se solicitará al pulsar la acción de crear una nota por voz. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- La app sigue siendo útil con texto aunque el dispositivo no tenga micrófono. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Da visibilidad al servicio de reconocimiento en Android 11 o superior. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".PensieveApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pensieve">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Pensieve"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Solo los PendingIntent creados por Pensieve pueden completar una nota. -->
        <receiver
            android:name=".notifications.CompleteReminderReceiver"
            android:exported="false" />
    </application>

</manifest>
